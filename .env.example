# Integration Gateway configuration
# Copy to .env or export in your shell.

# HTTP server port
PORT=3000

# Per-app auth/config. Convention: APP_<APPNAME>_<KEY>
# (uppercased app name, non-alphanumerics replaced with '_')
# These are exposed to components as ctx.auth[<lowercased key>].
# Example for a mirrored GitHub app:
# APP_GITHUB_ACCESS_TOKEN=ghp_xxx
# APP_SLACK_BOT_TOKEN=xoxb-xxx
# APP_STRIPE_SECRET_KEY=sk_test_xxx

# Optional: persist the key-value store used by components to a file
# STORE_FILE=.data/store.json

# Optional: comma-separated auth/config keys whose values are redacted in logs
# LOG_REDACT_KEYS=access_token,token,secret,password,api_key
